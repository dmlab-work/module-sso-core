{
    "name": "dmlab/module-sso-core",
    "description": "Shared OIDC/SSO engine for DmLab identity products (generic OIDC client, mapping engine, provider preset contract).",
    "type": "magento2-module",
    "version": "0.2.3",
    "license": "OSL-3.0",
    "keywords": [
        "magento2",
        "magento2-module",
        "magento 2",
        "sso",
        "single sign-on",
        "oidc",
        "openid connect",
        "oauth2",
        "pkce",
        "jwt",
        "okta",
        "azure ad",
        "entra id"
    ],
    "homepage": "https://github.com/dmlab-work/module-sso-core",
    "support": {
        "issues": "https://github.com/dmlab-work/module-sso-core/issues",
        "source": "https://github.com/dmlab-work/module-sso-core"
    },
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "ext-curl": "*",
        "magento/framework": "^103.0.7",
        "web-token/jwt-framework": "^3.4.10||~4.0.7||^4.1.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5||^12.5"
    },
    "conflict": {
        "dmlab/module-admin-sso": "<0.2.2",
        "dmlab/module-customer-sso": "<0.2.2"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "DmLab\\SsoCore\\": ""
        }
    }
}
